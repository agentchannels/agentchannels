{
  "name": "agentchannels",
  "version": "1.0.0",
  "description": "Connect an existing local Claude Code environment to Slack and Linear.",
  "type": "module",
  "bin": {
    "agentchannels": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts/restore-database.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "biome ci . && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.235",
    "@inquirer/prompts": "7.5.3",
    "@napi-rs/keyring": "1.3.0",
    "better-sqlite3": "13.0.3",
    "commander": "14.0.0",
    "ws": "8.21.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "@types/ws": "8.18.1",
    "tsup": "8.5.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.9.0"
}
