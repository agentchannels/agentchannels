{
  "name": "agentchannels",
  "version": "0.3.0",
  "private": true,
  "description": "Connect an existing local Claude Code environment to Slack and Linear.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentchannels": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "dev": "AGENTCHANNELS_HOME=.dev bun src/cli.ts",
    "dev:daemon": "AGENTCHANNELS_HOME=.dev bun --watch src/cli.ts daemon",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli.ts --compile --minify --sourcemap --outfile dist/agentchannels"
  },
  "dependencies": {
    "@agentchannels/protocol": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.235",
    "@inquirer/prompts": "7.5.3",
    "@napi-rs/keyring": "1.3.0",
    "commander": "14.0.0",
    "zod": "4.1.5"
  }
}
